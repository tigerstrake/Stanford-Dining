# Copy this file to .env and fill in your secrets.
# Never commit .env to version control.

OPENAI_API_KEY=sk-...

# Telegram Bot API (see README "Telegram setup"). Token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AA...
# Your chat id (a number; negative for groups). Comma-separate several to fan out.
TELEGRAM_CHAT_ID=123456789
