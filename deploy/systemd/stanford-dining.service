[Unit]
Description=Stanford dining recommender (one run)
OnFailure=stanford-dining-failed.service

[Service]
Type=oneshot
WorkingDirectory=%h/dev/Stanford-Dining
EnvironmentFile=%h/dev/Stanford-Dining/.env
ExecStartPre=-/bin/bash %h/dev/Stanford-Dining/deploy/hc-ping.sh start
# Pull main, install requirements, sync these units, and restart the bot if
# anything changed. Best-effort ("-"): the checked-out code runs regardless.
ExecStartPre=-/bin/bash %h/dev/Stanford-Dining/deploy/update.sh
ExecStart=%h/dev/Stanford-Dining/.venv/bin/python -m src.main --meal auto
ExecStartPost=-/bin/bash %h/dev/Stanford-Dining/deploy/hc-ping.sh
TimeoutStartSec=15min
